rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDailyLog(data, userId, dateKey) {
      return data.userId is string &&
             data.userId == userId &&
             data.dateKey is string &&
             data.dateKey == dateKey &&
             data.morningTaken is bool &&
             data.lunchTaken is bool &&
             data.dinnerTaken is bool &&
             data.waterCups is int &&
             data.waterCups >= 0 &&
             data.waterCups <= 30 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/daily_logs/{dateKey} {
      allow get: if isOwner(userId) && isValidId(dateKey) && isValidDateKey(dateKey);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(dateKey) &&
                       isValidDateKey(dateKey) &&
                       incoming().keys().hasAll([
                         'userId', 'dateKey', 'morningTaken', 'lunchTaken',
                         'dinnerTaken', 'waterCups', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'dateKey', 'morningTaken', 'lunchTaken',
                         'dinnerTaken', 'waterCups', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       isValidDailyLog(incoming(), userId, dateKey);

      allow update: if isOwner(userId) &&
                       isValidId(dateKey) &&
                       isValidDateKey(dateKey) &&
                       isValidDailyLog(incoming(), userId, dateKey) &&
                       incoming().userId == existing().userId &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['morningTaken', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['lunchTaken', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['dinnerTaken', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['waterCups', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(dateKey) && isValidDateKey(dateKey);
    }
  }
}
